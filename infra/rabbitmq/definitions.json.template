{
  "vhosts": [
    {"name": "/"}
  ],
  "users": [
    {
      "name": "__RABBITMQ_USER__",
      "password": "__RABBITMQ_PASSWORD__",
      "tags": "administrator"
    }
  ],
  "permissions": [
    {
      "user": "__RABBITMQ_USER__",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "unihub.events",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "unihub.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "q.ai.summarization",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "unihub.dlx",
        "x-dead-letter-routing-key": "dlq"
      }
    },
    {
      "name": "q.notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "unihub.dlx",
        "x-dead-letter-routing-key": "dlq"
      }
    },
    {
      "name": "q.search",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "unihub.dlx",
        "x-dead-letter-routing-key": "dlq"
      }
    },
    {
      "name": "q.dlq.unihub",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "unihub.events",
      "vhost": "/",
      "destination": "q.ai.summarization",
      "destination_type": "queue",
      "routing_key": "ai.summarization",
      "arguments": {}
    },
    {
      "source": "unihub.events",
      "vhost": "/",
      "destination": "q.notifications",
      "destination_type": "queue",
      "routing_key": "notifications",
      "arguments": {}
    },
    {
      "source": "unihub.events",
      "vhost": "/",
      "destination": "q.search",
      "destination_type": "queue",
      "routing_key": "search",
      "arguments": {}
    },
    {
      "source": "unihub.dlx",
      "vhost": "/",
      "destination": "q.dlq.unihub",
      "destination_type": "queue",
      "routing_key": "dlq",
      "arguments": {}
    }
  ]
}
