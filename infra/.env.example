# =============================================================================
# UniHub Workshop — Infrastructure Environment Variables
# =============================================================================
# USAGE:
#   - Copy this file to .env (same directory) for local development.
#   - Fill in the actual values. Never commit .env to version control.
#   - Both files .env and .env.example must be kept in sync.
# 
# The docker-compose.yml file uses these environment variables to configure the services.
# =============================================================================

# =============================================================================
# Redis — Cache & Rate Limiting
# =============================================================================
REDIS_PASSWORD=your-redis-password

# =============================================================================
# RabbitMQ — Message Broker
# =============================================================================
RABBITMQ_DEFAULT_USER=your-rabbitmq-user
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password

# =============================================================================
# MinIO — Object Storage (S3-compatible)
# =============================================================================
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=http://localhost:9000

# =============================================================================
# Grafana — Monitoring & Visualization
# =============================================================================
GRAFANA_ADMIN_USER=your-grafana-admin-user
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password

# =============================================================================
# Nginx Upstream Configuration
# =============================================================================
# For development (apps running on host machine)
BACKEND_1_HOST=host.docker.internal:8081
BACKEND_2_HOST=host.docker.internal:8082
WORKERS_HOST=host.docker.internal:8083
# For production (apps running fully inside Docker)
# BACKEND_1_HOST=unihub-backend-1:8080
# BACKEND_2_HOST=unihub-backend-2:8080
# WORKERS_HOST=unihub-workers:8080
