# Spring Boot active profile
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (Neon)
NEON_PRIMARY_URL=your_primary_database_url
NEON_REPLICA_URL=your_replica_database_url
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT secret keys
JWT_PRIVATE_KEY_PATH=file:../certs/private.pem
JWT_PUBLIC_KEY_PATH=file:../certs/public.pem
JWT_ISSUER=unihub

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/

# S3 (MinIO via AWS SDK)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_minio_user
S3_SECRET_KEY=your_minio_password
S3_BUCKET=unihub-assets
S3_PATH_STYLE_ACCESS=true
BROCHURE_BASE_URL=your_brochure_base_url

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=no-reply@unihub.com

# AI service
AI_SERVICE_API_KEY=your_ai_api_key
