# App Servers
APP_SERVER_1=unihub-backend-1:8080
APP_SERVER_2=unihub-backend-2:8080

# PostgreSQL (Neon)
NEON_PRIMARY_URL=your-primary-database-url
NEON_REPLICA_URL=your-replica-database-url
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Redis
REDIS_PASSWORD=your-redis-password

# RabbitMQ
RABBITMQ_DEFAULT_USER=your-rabbitmq-user
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/

# MinIO
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-minio-password
MINIO_REGION=ap-southeast-1
MINIO_BUCKET=unihub-assets

# Stripe
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
