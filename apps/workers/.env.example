# =============================================================================
# UniHub Workshop — Workers Environment Variables
# =============================================================================
# USAGE:
#   - Copy this file to .env (same directory) for local development.
#   - Fill in the actual values. Never commit .env to version control.
#   - Both files .env and .env.example must be kept in sync.
#
# The dotenv library (springboot4-dotenv) loads the .env file automatically
# when the 'dev' Spring profile is active. Production environments must
# inject these as real environment variables; .env is never used in prod.
# =============================================================================

# =============================================================================
# Spring Profile
# =============================================================================
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# Database — Neon PostgreSQL (Serverless)
# =============================================================================
# Primary Database (Writes & Consistent Reads)
SPRING_DATASOURCE_PRIMARY_URL=jdbc:postgresql://your-neon-primary-host.neon.tech/your-db?sslmode=require
SPRING_DATASOURCE_PRIMARY_USERNAME=your-neon-primary-username
SPRING_DATASOURCE_PRIMARY_PASSWORD=your-neon-primary-password
SPRING_DATASOURCE_PRIMARY_HIKARI_MAXIMUM_POOL_SIZE=10

# Replica Database (Eventual Consistency Reads)
SPRING_DATASOURCE_REPLICA_URL=jdbc:postgresql://your-neon-replica-host.neon.tech/your-db?sslmode=require
SPRING_DATASOURCE_REPLICA_USERNAME=your-neon-replica-username
SPRING_DATASOURCE_REPLICA_PASSWORD=your-neon-replica-password
SPRING_DATASOURCE_REPLICA_HIKARI_MAXIMUM_POOL_SIZE=10

# =============================================================================
# Redis — Cache & Capacity Counters
# =============================================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your-redis-password

# =============================================================================
# RabbitMQ — Message Broker
# =============================================================================
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=your-rabbitmq-user
SPRING_RABBITMQ_PASSWORD=your-rabbitmq-password

# =============================================================================
# Elasticsearch — CQRS Read Model
# =============================================================================
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# =============================================================================
# MinIO — Object Storage (S3-compatible)
# =============================================================================
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=http://localhost:9000

# =============================================================================
# Mail — Notification Service
# =============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-mail-username
SPRING_MAIL_PASSWORD=your-mail-password
NOTIFICATIONS_MAIL_FROM=noreply@unihub.edu.vn
NOTIFICATIONS_MAIL_FROM_NAME=UniHub Workshop

# =============================================================================
# Nightly Student CSV Ingestion
# =============================================================================
INGESTION_CRON=0 0 2 * * ?
INGESTION_EXPECTED_FACULTIES=Information Technology,Mathematics,Physics,Chemistry
INGESTION_REJECT_DIR=build/tmp/rejects
INGESTION_MAX_FILE_SIZE=104857600

# =============================================================================
# TTL Cleanup Scheduler — Interval (Cron Expression)
# =============================================================================
TTL_CLEANUP_CRON=0 0 */6 * * *

# =============================================================================
# AI Brochure Summarization (Google Gemini API / Mock)
# =============================================================================
# 'mock' (offline dev/test) or 'gemini' (Google Gemini API)
AI_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
